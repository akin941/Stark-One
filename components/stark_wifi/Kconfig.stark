# stark_wifi options (STARK-1005, ADR-0028), shown in the single STARK menu:
# main/Kconfig.projbuild sources this file (ARCHITECTURE.md §9). The radio is
# receive-only and brought up lazily by the analysis app, never at boot.

config STARK_WIFI_POLL_MS
    int "Wi-Fi: receive poll timeout (ms)"
    range 50 2000
    default 200
    help
        How long the service task waits for a frame before looping while the
        radio is up. Below this it also notices a stop request promptly.

config STARK_WIFI_TASK_PRIO
    int "Wi-Fi task priority"
    range 1 4
    default 2
    help
        Below the app worker (4) and the UI task (5).

config STARK_WIFI_TASK_STACK
    int "Wi-Fi task stack (bytes)"
    range 3072 8192
    default 4096
