# stark_subghz options, shown in the single STARK menu: main/Kconfig.projbuild
# sources this file (ARCHITECTURE.md §9). STARK-0601. The band, the power cap and
# the transmit limits are constants in code, never options (ADR-0022 §5–6).

config STARK_SUBGHZ_SPI_HZ
    int "Sub-GHz: CC1101 SPI clock (Hz)"
    range 100000 6500000
    default 4000000
    help
        The CC1101 reads status registers and bursts at up to 6.5 MHz.

config STARK_SUBGHZ_POLL_MS
    int "Sub-GHz: module check period (ms)"
    range 100 5000
    default 250

config STARK_SUBGHZ_TASK_PRIO
    int "Sub-GHz task priority"
    range 1 4
    default 2
    help
        Below the app worker (4) and the UI task (5).

config STARK_SUBGHZ_TASK_STACK
    int "Sub-GHz task stack (bytes)"
    range 3072 8192
    default 4096
