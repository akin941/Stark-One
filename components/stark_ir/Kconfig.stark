# stark_ir options, shown in the single STARK menu: main/Kconfig.projbuild
# sources this file (ARCHITECTURE.md §9). STARK-0303.

config STARK_IR_TASK_PRIO
    int "IR task priority"
    range 1 4
    default 3
    help
        Below the app worker (4) and the UI task (5).

config STARK_IR_TASK_STACK
    int "IR task stack (bytes)"
    range 2048 8192
    default 3072

config STARK_IR_TX_MIN_INTERVAL_MS
    int "IR: minimum time between transmissions (ms)"
    range 1000 60000
    default 1000
    help
        A transmission is refused (busy) until this long after the previous
        one ended — no transmit loops (SECURITY_SCOPE §4.4). The floor of
        1000 ms cannot be configured away.
