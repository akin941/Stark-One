# stark_storage options, shown in the single STARK menu: main/Kconfig.projbuild
# sources this file (ARCHITECTURE.md §9). TASKS.md STARK-0201.

config STARK_STORAGE_RETRY_MS
    int "Storage: mount retry period (ms)"
    range 1000 60000
    default 3000
    help
        While no usable card is mounted, a mount is attempted this often.
        There is no card-detect pin (ADR-0018 §5): polling is how an
        inserted card is found.

config STARK_STORAGE_PROBE_MS
    int "Storage: presence probe period (ms)"
    range 250 10000
    default 1000
    help
        While a card is mounted, it is asked (CMD13) this often whether it
        is still there; an I/O error also triggers a probe at once.

config STARK_STORAGE_TASK_PRIO
    int "Storage task priority"
    range 1 4
    default 2
    help
        Below the app worker (4) and the UI task (5).

config STARK_STORAGE_TASK_STACK
    int "Storage task stack (bytes)"
    range 3072 8192
    default 4096

config STARK_STORAGE_LOG_FLUSH_MS
    int "Storage: log file flush period (ms)"
    range 250 10000
    default 1000
    help
        While a card is mounted, the captured console lines
        (STARK_LOG_RING_BYTES) are appended to logs/stark.log this often.
        A removal loses at most one period's lines. Capture off (ring 0)
        means no log file.

config STARK_STORAGE_LOG_FILE_KB
    int "Storage: log file size before rotation (kB)"
    range 4 1024
    default 64

config STARK_STORAGE_LOG_FILES
    int "Storage: log files kept (stark.log + older)"
    range 1 8
    default 4
    help
        The log directory never holds more than this many files of
        STARK_STORAGE_LOG_FILE_KB each, plus one flush.
